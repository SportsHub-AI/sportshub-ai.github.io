{
  "name": "sportshub-web",
  "version": "1.0.0",
  "description": "SportsHub.AI company website",
  "author": "SportsHub.AI",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npx tailwindcss -i assets/css/main.css -o static/css/style.css --watch\" \"node scripts/hugo.mjs server -D\"",
    "build": "tailwindcss -i assets/css/main.css -o static/css/style.css --minify && node scripts/hugo.mjs --minify --cleanDestinationDir",
    "build:css": "tailwindcss -i assets/css/main.css -o static/css/style.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.5"
  }
}
